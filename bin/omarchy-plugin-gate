#!/usr/bin/env -S python3 -I
# omarchy-plugin-gate — review Omarchy shell plugin updates before they land.
#
#   omarchy-plugin-gate add <git-url> [--dir NAME] [--no-enable]
#   omarchy-plugin-gate check [-p NAME]
#   omarchy-plugin-gate approve <name> [--sha SHA] [--reason TEXT] [--show] [-n]
#   omarchy-plugin-gate update [-p NAME]
#   omarchy-plugin-gate status [-p NAME]
#   omarchy-plugin-gate doctor [-p NAME] [--fix]
#
# Setting options (--root, --state, --agent, --model, --notify, --timeout,
# --max-patch) go before or after the command and beat the environment, which
# beats ~/.config/omarchy-plugin-gate/config.toml.
#
# A launcher for the code in ../src, run by the system Python with the standard
# library only. -I keeps PYTHONPATH, user site-packages and the working
# directory out of the import path. Hooks and the systemd unit call this file.

import sys

if sys.version_info < (3, 14):  # noqa: UP036 - the point is a clear message on old Pythons
    sys.exit("omarchy-plugin-gate: needs Python 3.14 or newer")

from pathlib import Path

SELF = Path(__file__).resolve()
sys.path.insert(0, str(SELF.parent.parent / "src"))

from omarchy_plugin_gate.cli import main  # noqa: E402

raise SystemExit(main(SELF))
