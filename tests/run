#!/usr/bin/env bash
# Fixture test suite for omarchy-plugin-gate.
#
# Each suite in tests/suites/ runs in its own subshell against a fresh fixture:
# throwaway repositories, a stub reviewer and stub omarchy commands under a
# temporary directory. Never touches the real plugin install, never uses the
# network, never calls a real model.
#
#   tests/run [--keep] [suite ...]
#
# With no suite named, every suite runs. The fixture is kept for inspection
# when a check fails or --keep is given.

set -uo pipefail

TESTS=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
REPO=$(dirname "$TESTS")
GATE=${GATE:-$REPO/bin/omarchy-plugin-gate}
KEEP=0

all=()
for f in "$TESTS"/suites/*.sh; do
  all+=("$(basename "$f" .sh)")
done

names=()
for arg in "$@"; do
  case $arg in
  --keep) KEEP=1 ;;
  -*)
    printf 'usage: tests/run [--keep] [suite ...]\n' >&2
    exit 2
    ;;
  *)
    if [[ ! -f $TESTS/suites/$arg.sh ]]; then
      printf 'tests/run: no suite %s (suites: %s)\n' "$arg" "${all[*]}" >&2
      exit 2
    fi
    names+=("$arg")
    ;;
  esac
done
((${#names[@]} > 0)) || names=("${all[@]}")

ROOT=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-plugin-gate-test.XXXXXX")
FAILED=$ROOT/failed
: >"$FAILED"

cleanup() {
  if [[ ! -s $FAILED ]] && ((KEEP == 0)); then
    rm -rf "$ROOT"
  else
    printf '\nfixture kept at %s\n' "$ROOT"
  fi
}
trap cleanup EXIT

source "$TESTS/lib/assert.sh"

for SUITE in "${names[@]}"; do
  printf '\n[%s]\n' "$SUITE"
  B=$ROOT/$SUITE
  mkdir -p "$B"
  if ! bash -n "$TESTS/suites/$SUITE.sh"; then
    no 'suite has a syntax error'
    continue
  fi
  (
    source "$TESTS/lib/fixture.sh"
    source "$TESTS/lib/gate.sh"
    setup_env
    source "$TESTS/suites/$SUITE.sh"
    : >"$B/.finished"
  )
  [[ -e $B/.finished ]] || no 'suite stopped before its last check'
done

printf '\n'
if [[ -s $FAILED ]]; then
  printf '%d check(s) FAILED\n' "$(wc -l <"$FAILED")"
  sed 's/^/  /' "$FAILED"
  exit 1
fi
printf 'all checks passed\n'
